{
  "name": "online-gaming",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter @og/web typecheck",
    "check": "pnpm typecheck && pnpm test",
    "simula": "tsx games/primo-gioco/scripts/simula.ts",
    "simula:ufficio": "tsx games/ufficio/scripts/simula.ts",
    "simula:famiglia": "tsx games/famiglia/scripts/simula.ts",
    "vocali:famiglia": "tsx games/famiglia/scripts/vocali.ts",
    "strategie:famiglia": "tsx games/famiglia/scripts/strategie.ts",
    "stampa:famiglia": "tsx games/famiglia/scripts/stampa.ts",
    "carte": "tsx games/primo-gioco/scripts/anteprima-carte.ts",
    "carte:ufficio": "tsx games/ufficio/scripts/anteprima-carte.ts",
    "matrice:famiglia": "tsx games/famiglia/scripts/matrice.ts",
    "codici:famiglia": "tsx games/famiglia/scripts/codici.ts",
    "web": "pnpm --filter @og/web dev",
    "test:supabase": "vitest run -c vitest.supabase.config.ts",
    "build:arbitro": "esbuild packages/server/src/index.ts --bundle --format=esm --platform=neutral --main-fields=module,main --target=es2022 --external:@supabase/supabase-js --outfile=supabase/functions/arbitro/nucleo.js",
    "deploy:arbitro": "pnpm build:arbitro && supabase functions deploy arbitro --use-api"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@types/node": "^20",
    "@types/pdfkit": "0.13.9",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "pdfkit": "0.15.2",
    "supabase": "^2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "ws": "^8.18.0"
  }
}

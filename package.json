{
  "name": "online-gaming",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter @og/web typecheck",
    "check": "pnpm typecheck && pnpm test",
    "simula": "tsx games/primo-gioco/scripts/simula.ts",
    "carte": "tsx games/primo-gioco/scripts/anteprima-carte.ts",
    "web": "pnpm --filter @og/web dev",
    "test:supabase": "vitest run -c vitest.supabase.config.ts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@types/node": "^20",
    "@types/ws": "^8.5.13",
    "supabase": "^2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "ws": "^8.18.0"
  }
}
